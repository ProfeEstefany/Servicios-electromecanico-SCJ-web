---
// src/components/WhatsAppButton.astro - 3 Botones Directos de WhatsApp SCJ
---

<div class="whatsapp-stack">
    <a
        href="https://whatsapp.com"
        target="_blank"
        rel="noopener noreferrer"
        class="whatsapp-float"
        aria-label="WhatsApp 1: (664) 711-29-23"
    >
        <img src="/Imagenes/iconos/whatsApp.jpeg" alt="WhatsApp" class="whatsapp-icon" />
        <span class="wa-number-tag">1</span>
        <span class="whatsapp-tooltip">WhatsApp 1: (664) 711-29-23</span>
    </a>

    <a
        href="https://whatsapp.com"
        target="_blank"
        rel="noopener noreferrer"
        class="whatsapp-float"
        aria-label="WhatsApp 2: (663) 197-55-90"
    >
        <img src="/Imagenes/iconos/whatsApp.jpeg" alt="WhatsApp" class="whatsapp-icon" />
        <span class="wa-number-tag">2</span>
        <span class="whatsapp-tooltip">WhatsApp 2: (663) 197-55-90</span>
    </a>

    <a
        href="https://whatsapp.com"
        target="_blank"
        rel="noopener noreferrer"
        class="whatsapp-float"
        aria-label="WhatsApp 3: (686) 247-57-83"
    >
        <img src="/Imagenes/iconos/whatsApp.jpeg" alt="WhatsApp" class="whatsapp-icon" />
        <span class="wa-number-tag">3</span>
        <span class="whatsapp-tooltip">WhatsApp 3: (686) 247-57-83</span>
    </a>
</div>

<style>
    .whatsapp-stack {
        position: fixed;
        bottom: 28px;
        left: 24px;
        z-index: 10005;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .whatsapp-float {
        position: relative;
        width: 60px;
        height: 60px;
        background-color: #25D366;
        color: white;
        border-radius: 50%;
        text-align: center;
        font-size: 30px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: transform 0.3s ease;
    }

    .whatsapp-float:hover {
        transform: scale(1.1);
    }

    .whatsapp-icon {
        width: 35px;
        height: 35px;
        border-radius: 50%;
    }

    .wa-number-tag {
        position: absolute;
        top: -2px;
        right: -2px;
        background-color: #d90429;
        color: #ffffff;
        font-size: 0.75rem;
        font-weight: bold;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid #ffffff;
    }

    .whatsapp-tooltip {
        visibility: hidden;
        background-color: var(--color-texto-oscuro);
        color: #00FF00;
        font-weight: bold;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.7);
        text-align: center;
        border-radius: 6px;
        padding: 5px 12px;
        position: absolute;
        z-index: 1;
        left: 112%;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0;
        transition: opacity 0.3s ease, visibility 0.3s ease;
        font-size: 0.9rem;
        white-space: nowrap;
    }

    .whatsapp-tooltip::after {
        content: "";
        position: absolute;
        top: 50%;
        right: 100%;
        margin-top: -5px;
        border-width: 5px;
        border-style: solid;
        border-color: transparent var(--color-texto-oscuro) transparent transparent;
    }

    .whatsapp-float:hover .whatsapp-tooltip {
        visibility: visible;
        opacity: 1;
    }

    @media (max-width: 768px) {
        .whatsapp-stack {
            bottom: 15px;
            left: 15px;
            gap: 8px;
        }
        .whatsapp-float {
            width: 50px;
            height: 50px;
            font-size: 24px;
        }
        .whatsapp-icon {
            width: 30px;
            height: 30px;
        }
        .whatsapp-tooltip {
            left: 108%;
            font-size: 0.8em;
        }
    }
</style>


