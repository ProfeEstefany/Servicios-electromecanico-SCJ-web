---
// src/components/ChristmasBottom.astro
const path = Astro.url.pathname;
const isCotizacion = path.includes('cotizacion');
const isServiciosGroup =
  path.includes('nuestros-servicios') ||
  path.includes('embobinados') ||
  path.includes('compresores') ||
  path.includes('seguridad-electronica') ||
  path.includes('contactanos');
---

<div class="snow-ground-wrapper" aria-hidden="true">
  {/* Montañas de nieve acumulada en el suelo */}
  <svg class="snow-hills" viewBox="0 0 1440 90" preserveAspectRatio="none">
    <path d="M0,45 Q180,10 360,48 T720,40 T1080,50 T1440,35 L1440,90 L0,90 Z" fill="#dceefb" />
    <path d="M0,58 Q240,25 480,60 T960,48 T1440,55 L1440,90 L0,90 Z" fill="#ffffff" />
  </svg>

  {/* Renos navideños caminando (en Servicios, Embobinados, Compresores, Seguridad, Contáctanos y Cotización) */}
  {(isServiciosGroup || isCotizacion) && (
    <div class="reindeer-parade">
      <div class="reindeer-walker">
        <svg viewBox="0 0 140 70" width="125" height="62">
          {/* Trineo / Segundo Reno */}
          <g transform="translate(5, 8)">
            <ellipse cx="32" cy="36" rx="16" ry="9" fill="#8d5524" />
            <circle cx="48" cy="24" r="7" fill="#8d5524" />
            <circle cx="54" cy="24" r="2.5" fill="#d90429" />
            <path d="M46,17 L43,6 M43,11 L39,9 M50,17 L53,6 M53,11 L57,9" stroke="#e6ccb2" stroke-width="2" stroke-linecap="round" />
            <line x1="22" y1="43" x2="18" y2="58" stroke="#6f3e18" stroke-width="3" />
            <line x1="28" y1="43" x2="31" y2="58" stroke="#6f3e18" stroke-width="3" />
            <line x1="38" y1="43" x2="35" y2="58" stroke="#6f3e18" stroke-width="3" />
            <line x1="44" y1="43" x2="48" y2="58" stroke="#6f3e18" stroke-width="3" />
          </g>
          {/* Reno Rodolfo adelante */}
          <g transform="translate(68, 6)">
            <ellipse cx="32" cy="36" rx="17" ry="10" fill="#a46632" />
            <circle cx="49" cy="23" r="7.5" fill="#a46632" />
            <circle cx="56" cy="23" r="3.2" fill="#ff002b" class="rudolph-nose" />
            <circle cx="50" cy="21" r="1.5" fill="#111" />
            <path d="M47,16 L44,4 M44,10 L40,8 M51,16 L54,4 M54,10 L58,8" stroke="#f5ebe0" stroke-width="2.2" stroke-linecap="round" />
            <path d="M40,29 L45,35" stroke="#d90429" stroke-width="3" />
            <circle cx="45" cy="36" r="2.2" fill="#ffd700" />
            <line x1="22" y1="44" x2="17" y2="60" stroke="#7f4f24" stroke-width="3" />
            <line x1="28" y1="44" x2="32" y2="60" stroke="#7f4f24" stroke-width="3" />
            <line x1="38" y1="44" x2="34" y2="60" stroke="#7f4f24" stroke-width="3" />
            <line x1="44" y1="44" x2="49" y2="60" stroke="#7f4f24" stroke-width="3" />
          </g>
        </svg>
      </div>
    </div>
  )}

  {/* Pino Navideño Adornado + Regalos + Tren girando alrededor diciendo SCJ */}
  <div class="tree-and-train">
    <svg viewBox="0 0 220 165" width="185" height="140">
      {/* Tronco */}
      <rect x="100" y="122" width="20" height="22" fill="#5c3a21" />
      {/* Capas del Pino */}
      <polygon points="110,16 62,64 158,64" fill="#146c43" />
      <polygon points="110,42 50,96 170,96" fill="#198754" />
      <polygon points="110,68 38,128 182,128" fill="#0f5132" />
      {/* Nieve en las puntas del pino */}
      <path d="M62,64 Q85,58 110,64 Q135,58 158,64" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" />
      <path d="M50,96 Q80,89 110,96 Q140,89 170,96" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" />
      {/* Estrella en la punta */}
      <polygon points="110,2 113,11 122,11 115,16 118,25 110,20 102,25 105,16 98,11 107,11" fill="#ffd700" />
      {/* Esferas y luces en el pino */}
      <circle cx="96" cy="48" r="4" fill="#ff002b" />
      <circle cx="124" cy="52" r="4" fill="#ffd700" />
      <circle cx="82" cy="78" r="4.5" fill="#00b4d8" />
      <circle cx="112" cy="74" r="4.5" fill="#ff002b" />
      <circle cx="138" cy="82" r="4.5" fill="#ffd700" />
      <circle cx="68" cy="110" r="5" fill="#ffd700" />
      <circle cx="98" cy="106" r="5" fill="#ff002b" />
      <circle cx="128" cy="112" r="5" fill="#00b4d8" />
      <circle cx="154" cy="108" r="5" fill="#ff002b" />

      {/* Regalitos al pie del árbol */}
      <rect x="62" y="128" width="22" height="18" fill="#d90429" rx="2" />
      <line x1="73" y1="128" x2="73" y2="146" stroke="#ffd700" stroke-width="3" />
      <rect x="136" y="130" width="24" height="16" fill="#0056b3" rx="2" />
      <line x1="148" y1="130" x2="148" y2="146" stroke="#fff" stroke-width="3" />

      {/* Vía ovalada alrededor del árbol */}
      <ellipse cx="110" cy="148" rx="95" ry="11" fill="none" stroke="#495057" stroke-width="3" stroke-dasharray="6 4" />
    </svg>

    {/* Trenecito animado que gira alrededor del pino diciendo SCJ */}
        {/* Trenecito de juguete real girando alrededor del pino con SCJ */}
    <div class="orbit-train">
      <svg viewBox="0 0 130 48" width="115" height="42">
        {/* Humo blanco de la chimenea */}
        <circle cx="95" cy="8" r="4" fill="#ffffff" opacity="0.85" />
        <circle cx="87" cy="5" r="3" fill="#ffffff" opacity="0.65" />
        {/* Vagón trasero con regalos y letras SCJ */}
        <rect x="6" y="16" width="46" height="20" rx="3" fill="#0056b3" stroke="#ffd700" stroke-width="1.5" />
        <rect x="12" y="10" width="12" height="6" fill="#d90429" />
        <rect x="28" y="9" width="14" height="7" fill="#198754" />
        <text x="29" y="30" fill="#ffffff" font-size="11" font-weight="900" text-anchor="middle">SCJ</text>
        {/* Enganche */}
        <line x1="52" y1="30" x2="60" y2="30" stroke="#ffd700" stroke-width="2.5" />
        {/* Locomotora Roja y Dorada */}
        <rect x="60" y="14" width="42" height="22" rx="3" fill="#d90429" stroke="#ffd700" stroke-width="1.5" />
        {/* Cabina del maquinista */}
        <rect x="60" y="6" width="18" height="12" rx="2" fill="#9b2226" stroke="#ffd700" stroke-width="1.2" />
        <rect x="63" y="9" width="11" height="6" fill="#fffbe6" />
        {/* Chimenea */}
        <polygon points="90,14 98,14 100,6 88,6" fill="#1f2937" />
        {/* Tope frontal dorado */}
        <polygon points="102,24 112,36 102,36" fill="#ffd700" />
        {/* Ruedas del tren */}
        <circle cx="16" cy="38" r="5" fill="#1f2937" stroke="#ffd700" stroke-width="1.5" />
        <circle cx="42" cy="38" r="5" fill="#1f2937" stroke="#ffd700" stroke-width="1.5" />
        <circle cx="70" cy="38" r="6" fill="#1f2937" stroke="#ffd700" stroke-width="1.5" />
        <circle cx="92" cy="38" r="5" fill="#1f2937" stroke="#ffd700" stroke-width="1.5" />
      </svg>
    </div>


  {/* Buzón Navideño Abierto lleno de Cartas (Solo en la página de Cotización) */}
  {isCotizacion && (
    <div class="christmas-mailbox" title="Buzón de Cotizaciones Navideñas">
      <svg viewBox="0 0 130 130" width="115" height="115">
        {/* Poste nevado */}
        <rect x="58" y="65" width="12" height="60" fill="#6f4e37" />
        {/* Cuerpo del buzón rojo */}
        <rect x="28" y="34" width="68" height="36" rx="16" fill="#d90429" stroke="#fff" stroke-width="2" />
        {/* Banderita dorada levantada */}
        <line x1="78" y1="36" x2="78" y2="14" stroke="#ffd700" stroke-width="3" />
        <polygon points="78,14 94,19 78,24" fill="#ffd700" />
        {/* Puerta abierta del buzón */}
        <path d="M28,68 L8,82 L28,70 Z" fill="#9b2226" stroke="#fff" stroke-width="1.5" />
        {/* Cartas navideñas saliendo del buzón abierto */}
        <g transform="rotate(-18 24 54)">
          <rect x="10" y="42" width="26" height="17" fill="#fffbe6" stroke="#d90429" stroke-width="1.5" />
          <polyline points="10,42 23,51 36,42" fill="none" stroke="#d90429" stroke-width="1.5" />
        </g>
        <g transform="rotate(-5 26 58)">
          <rect x="14" y="47" width="26" height="17" fill="#ffffff" stroke="#198754" stroke-width="1.5" />
          <polyline points="14,47 27,56 40,47" fill="none" stroke="#198754" stroke-width="1.5" />
        </g>
        {/* Nieve encima del buzón */}
        <path d="M32,35 Q62,26 92,35" fill="none" stroke="#ffffff" stroke-width="5" stroke-linecap="round" />
      </svg>
    </div>
  )}
</div>

<style>
  .snow-ground-wrapper {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 145px;
    pointer-events: none;
    z-index: 900; /* Debajo del botón de WhatsApp para que WhatsApp siempre se vea */
  }

  .snow-hills {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 65px;
  }

  /* Pino y Tren en la esquina inferior derecha */
  .tree-and-train {
    position: absolute;
    bottom: 6px;
    right: 24px;
    width: 185px;
    height: 140px;
  }

  .orbit-train {
    position: absolute;
    bottom: 8px;
    left: 12px;
    width: 160px;
    animation: trainOrbit 7s ease-in-out infinite alternate;
  }

  .train-body {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(90deg, #d90429, #0056b3);
    color: #fff;
    font-weight: 900;
    font-size: 0.78rem;
    padding: 2px 8px;
    border-radius: 8px;
    border: 2px solid #ffd700;
    box-shadow: 0 3px 8px rgba(0,0,0,0.5);
  }

  @keyframes trainOrbit {
    0%   { transform: translateX(0px) translateY(0px) scale(0.95); z-index: 2; }
    50%  { transform: translateX(85px) translateY(5px) scale(1.05); z-index: 5; }
    100% { transform: translateX(0px) translateY(-6px) scale(0.88); z-index: 1; }
  }

  /* Renos caminando por el suelo nevado */
  .reindeer-parade {
    position: absolute;
    bottom: 18px;
    left: 0;
    width: 100%;
    overflow: hidden;
  }

  .reindeer-walker {
    display: inline-block;
    animation: walkAcross 18s linear infinite;
  }

  .rudolph-nose {
    animation: glowNose 0.8s infinite alternate;
  }

  @keyframes glowNose {
    from { opacity: 0.6; }
    to   { opacity: 1; filter: drop-shadow(0 0 6px #ff002b); }
  }

  @keyframes walkAcross {
    0%   { transform: translateX(-140px); }
    100% { transform: translateX(100vw); }
  }

  /* Buzón en Cotización */
  .christmas-mailbox {
    position: absolute;
    bottom: 14px;
    right: 215px;
  }

  @media (max-width: 768px) {
    .tree-and-train {
      transform: scale(0.75);
      right: 4px;
      bottom: 0;
    }
    .christmas-mailbox {
      transform: scale(0.75);
      right: 145px;
    }
  }
</style>
